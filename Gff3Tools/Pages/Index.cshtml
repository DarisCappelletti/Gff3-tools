@page
@model IndexModel
@{
    ViewData["Title"] = "Gff3 Tools";
    var primaRiga = (Model.Stato.Pagina - 1) * Model.Stato.PerPagina;
    bool HaFasta = Model.Dati.Any(r => !string.IsNullOrWhiteSpace(r.Fasta));
    bool HaCds = Model.Dati.Any(r => !string.IsNullOrWhiteSpace(r.CDS));
}

<div class="container py-4">

    <h1 class="h3 mb-1">Gff3 Tools</h1>
    <p class="text-muted mb-4">Analizza, filtra e modifica file GFF3 di annotazione genomica; esporta in GFF3, CDS o XLS.</p>

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5">Carica i file .gff3</h2>
            <form method="post" enctype="multipart/form-data" asp-page-handler="CaricaGff3" class="row g-3 align-items-end">
                <div class="col-auto">
                    <input asp-for="FileGff3" type="file" accept=".gff3,.gff,text/plain" multiple class="form-control" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Carica</button>
                </div>
            </form>
            @if (Model.NomiFile.Count > 0)
            {
                <div class="mt-3 d-flex flex-wrap align-items-center gap-2">
                    <span class="text-muted small">File caricati:</span>
                    @foreach (var nome in Model.NomiFile)
                    {
                        <span class="badge text-bg-secondary">@nome</span>
                    }
                    <a asp-page-handler="Azzera" class="btn btn-outline-danger btn-sm ms-2">Azzera tutto</a>
                </div>
            }
        </div>
    </div>

    @if (Model.Dati.Count > 0)
    {
        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h5">Filtri</h2>
                        <form method="post" asp-page-handler="Filtri">
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label mb-0 small">Contiene (parole separate da ;)</label>
                                    <input type="text" name="contiene" value="@Model.Stato.Contiene" class="form-control" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label mb-0 small">Non contiene (parole separate da ;)</label>
                                    <input type="text" name="nonContiene" value="@Model.Stato.NonContiene" class="form-control" />
                                </div>
                            </div>
                            <div class="small text-muted mb-1">Cerca nelle colonne:</div>
                            <div class="d-flex flex-wrap gap-3 mb-3">
                                @foreach (var colonna in StatoTabella.TutteLeColonne)
                                {
                                    var attiva = Model.Stato.ColonneRicerca.Contains(colonna);
                                    <div class="form-check">
                                        <input type="checkbox" name="colonne" value="@colonna" class="form-check-input"
                                               checked="@(attiva ? "checked" : null)" id="ricerca-@colonna" />
                                        <label class="form-check-label" for="ricerca-@colonna">@colonna</label>
                                    </div>
                                }
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">Filtra</button>
                            <a asp-page-handler="AzzeraFiltri" class="btn btn-outline-secondary btn-sm">Azzera filtri</a>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h5">Sequenze collegate</h2>
                        <p class="text-muted small mb-2">Collega ai file caricati le sequenze FASTA e CDS corrispondenti (ricerca per Sequid nell'intestazione &gt;).</p>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <form method="post" enctype="multipart/form-data" asp-page-handler="CaricaFasta" class="input-group input-group-sm">
                                    <input asp-for="FileFasta" type="file" accept=".fasta,.fa,.fna,text/plain" multiple class="form-control" />
                                    <button type="submit" class="btn btn-outline-primary">FASTA</button>
                                </form>
                            </div>
                            <div class="col-md-6">
                                <form method="post" enctype="multipart/form-data" asp-page-handler="CaricaCds" class="input-group input-group-sm">
                                    <input asp-for="FileCds" type="file" accept=".cds,.fasta,.fa,text/plain" multiple class="form-control" />
                                    <button type="submit" class="btn btn-outline-primary">CDS</button>
                                </form>
                            </div>
                        </div>
                        <hr class="my-3" />
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="small text-muted">Colonne visibili:</span>
                            @foreach (var colonna in StatoTabella.TutteLeColonne)
                            {
                                var visibile = Model.Stato.ColonneVisibili.Contains(colonna);
                                <a asp-page-handler="Colonna" asp-route-nome="@colonna"
                                   class="btn btn-sm @(visibile ? "btn-success" : "btn-outline-danger")">@colonna</a>
                            }
                        </div>
                        <div class="mt-2 d-flex flex-wrap align-items-center gap-2">
                            <span class="small text-muted">Risultati per pagina:</span>
                            @foreach (var dimensione in new[] { 50, 100, 250, 500 })
                            {
                                <a asp-page-handler="PerPagina" asp-route-perPagina="@dimensione"
                                   class="btn btn-sm @(Model.Stato.PerPagina == dimensione ? "btn-success" : "btn-outline-secondary")">@dimensione</a>
                            }
                            <div class="form-check ms-3">
                                <input type="checkbox" id="chkRaggruppa" class="form-check-input" />
                                <label class="form-check-label small" for="chkRaggruppa">Raggruppa i risultati per Sequid</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <form method="post" asp-page-handler="Esporta" id="formTabella">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <span class="fw-semibold">Ci sono <strong>@Model.RigheFiltrate.Count.ToString("N0")</strong> risultati.</span>
                <button type="submit" name="formato" value="gff3" class="btn btn-sm btn-success">Esporta GFF3</button>
                @if (HaCds)
                {
                    <button type="submit" name="formato" value="cds" class="btn btn-sm btn-success">Esporta CDS</button>
                }
                <button type="submit" name="formato" value="excel" class="btn btn-sm btn-success">Esporta Excel</button>
                <span class="text-muted small">Se selezioni alcune righe, viene esportata solo la selezione.</span>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-sm align-middle" id="tabellaGff3">
                    <thead>
                        <tr>
                            <th></th>
                            @foreach (var colonna in StatoTabella.TutteLeColonne)
                            {
                                if (Model.Stato.ColonneVisibili.Contains(colonna))
                                {
                                    var campo = colonna.ToLowerInvariant();
                                    var freccia = Model.Stato.Ordina == campo ? (Model.Stato.Discendente ? " ▼" : " ▲") : "";
                                    <th><a asp-page="Index" asp-route-ordina="@campo" asp-route-dir="asc" class="link-dark text-decoration-none">@colonna@freccia</a></th>
                                }
                            }
                            @if (HaFasta) { <th>Fasta</th> }
                            @if (HaCds) { <th>CDS</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var indice = primaRiga;
                        }
                        @foreach (var riga in Model.RighePagina)
                        {
                            var i = indice++;
                            <tr data-sequid="@riga.Sequid">
                                <td><input type="checkbox" name="righe" value="@i" class="form-check-input" /></td>
                                @if (Model.Stato.ColonneVisibili.Contains("File")) { <td class="text-nowrap">@riga.File</td> }
                                @if (Model.Stato.ColonneVisibili.Contains("Sequid")) { <td>@riga.Sequid</td> }
                                @if (Model.Stato.ColonneVisibili.Contains("Source")) { <td>@riga.Source</td> }
                                @if (Model.Stato.ColonneVisibili.Contains("Type")) { <td>@riga.Type</td> }
                                @if (Model.Stato.ColonneVisibili.Contains("Start")) { <td>@riga.Start</td> }
                                @if (Model.Stato.ColonneVisibili.Contains("End")) { <td>@riga.End</td> }
                                @if (Model.Stato.ColonneVisibili.Contains("Score")) { <td>@riga.Score</td> }
                                @if (Model.Stato.ColonneVisibili.Contains("Strand")) { <td>@riga.Strand</td> }
                                @if (Model.Stato.ColonneVisibili.Contains("Phase")) { <td>@riga.Phase</td> }
                                @if (Model.Stato.ColonneVisibili.Contains("Attributes"))
                                {
                                    <td>
                                        @foreach (var attributo in riga.Attributes)
                                        {
                                            var parti = attributo.Split('=', 2);
                                            if (parti.Length == 2)
                                            {
                                                <span class="badge text-bg-light border">@parti[0]</span> @parti[1]
                                            }
                                            else
                                            {
                                                @attributo
                                            }
                                        }
                                    </td>
                                }
                                @if (HaFasta)
                                {
                                    <td class="text-truncate small" style="max-width: 12rem;" title="@riga.Fasta">@riga.Fasta</td>
                                }
                                @if (HaCds)
                                {
                                    <td class="text-truncate small" style="max-width: 12rem;" title="@riga.CDS">@riga.CDS</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </form>

        @if (Model.TotalePagine > 1)
        {
            <nav aria-label="Pagine dei risultati">
                <ul class="pagination pagination-sm">
                    <li class="page-item @(Model.Stato.Pagina <= 1 ? "disabled" : null)">
                        <a class="page-link" asp-page="Index" asp-route-pagina="@(Model.Stato.Pagina - 1)">&laquo;</a>
                    </li>
                    @for (var p = 1; p <= Model.TotalePagine; p++)
                    {
                        <li class="page-item @(p == Model.Stato.Pagina ? "active" : null)">
                            <a class="page-link" asp-page="Index" asp-route-pagina="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Stato.Pagina >= Model.TotalePagine ? "disabled" : null)">
                        <a class="page-link" asp-page="Index" asp-route-pagina="@(Model.Stato.Pagina + 1)">&raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

<script>
    // Raggruppamento per Sequid sulla pagina corrente: come nel tool originale,
    // le righe consecutive con lo stesso Sequid si accorpano nella prima
    document.getElementById('chkRaggruppa')?.addEventListener('change', function () {
        const righe = [...document.querySelectorAll('#tabellaGff3 tbody tr')];
        const conteggi = new Map();
        for (const riga of righe) {
            const sequid = riga.dataset.sequid;
            const mostra = !conteggi.has(sequid);
            conteggi.set(sequid, (conteggi.get(sequid) ?? 0) + 1);
            riga.style.display = mostra ? '' : 'none';
        }
        for (const riga of righe) {
            const sequid = riga.dataset.sequid;
            const totale = conteggi.get(sequid);
            if (totale > 1) {
                const cella = riga.children[2];
                if (!cella.dataset.eraModificata) {
                    cella.dataset.eraModificata = '1';
                    cella.innerHTML += ' <span class="badge text-bg-secondary">' + totale + ' righe</span>';
                }
            }
        }
    });
</script>